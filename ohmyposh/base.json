{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#c4b28a",
          "foreground": "#0d0c0c",
          "leading_diamond": "\ue0b6",
          "powerline_symbol": "\ue0b0",
          "properties": {
            "style": "folder"
          },
          "style": "diamond",
          "template": " \ue5ff {{ .Path }} ",
          "trailing_diamond": "\ue0b0",
          "type": "path"
        },
        {
          "background": "#E6C384",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#c4746e{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#E46876{{ end }}",
            "{{ if gt .Ahead 0 }}#7FB4CA{{ end }}",
            "{{ if gt .Behind 0 }}#c4746e{{ end }}"
          ],
          "foreground": "#0d0c0c",
          "powerline_symbol": "\ue0b0",
          "properties": {
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "powerline",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "type": "git"
        },
        {
          "background": "#8a9a7b",
          "background_templates": [
            "{{ if gt .Code 0 }}#b97871{{ end }}"
          ],
          "foreground": "#0d0c0c",
          "leading_diamond": "<transparent,background>\ue0b0</>",
          "properties": {
            "always_enabled": true
          },
          "style": "diamond",
          "template": "{{ if gt .Code 0 }} {{ .Code }} {{ else }} \uf0e7 {{ end }}",
          "trailing_diamond": "\ue0b4",
          "type": "status"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 3
}